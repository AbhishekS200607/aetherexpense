{
  "cli": {
    "version": ">= 16.18.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "cache": {
        "key": "v1-dev",
        "paths": ["node_modules", "~/.gradle/caches", "~/.gradle/wrapper"]
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "cache": {
        "key": "v1-preview",
        "paths": ["node_modules", "~/.gradle/caches", "~/.gradle/wrapper"]
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      }
    },
    "production-apk": {
      "distribution": "internal",
      "channel": "production",
      "cache": {
        "key": "v1-prod-apk",
        "paths": ["node_modules", "~/.gradle/caches", "~/.gradle/wrapper"]
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "cache": {
        "key": "v1-prod",
        "paths": ["node_modules", "~/.gradle/caches", "~/.gradle/wrapper"]
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
